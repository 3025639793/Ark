{
  "name": "ark-local-album",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron .",
    "start:local": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/store.mjs && node --check public/app.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/updater.cjs && node --check lib/theme.mjs && node --check public/theme.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux dir"
  },
  "description": "Ark — 本地图片相册与加密收藏库",
  "author": "Aeval",
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.aeval.ark",
    "productName": "Ark",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "lib/**/*",
      "server.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Ark-${version}-windows-${arch}.${ext}",
      "verifyUpdateCodeSignature": false,
      "icon": "build/icon.png"
    },
    "extraFiles": [
      {
        "from": "WINDOWS-开始使用.txt",
        "to": "开始使用.txt"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "Ark-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "3025639793",
        "repo": "Ark"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
